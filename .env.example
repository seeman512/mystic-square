# Docker Compose PostgreSQL settings.
POSTGRES_DB=mystic_square
POSTGRES_USER=mystic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
APP_PORT=8080

# Set this directly to override the PG_* settings when running the API locally.
DATABASE_URL=
PG_USER=mystic
PG_DB=mystic_square
PG_PASSWORD=mystic
PG_PORT=5432
PG_HOST=localhost
# Optional: PG_SSLMODE=disable

# Required for API startup; use a unique random secret of at least 32 bytes.
JWT_SECRET=

# Set true for HTTPS deployments. Keep false for local HTTP development.
WEB_COOKIE_SECURE=false
