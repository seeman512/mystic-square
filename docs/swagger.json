    },
    "definitions": {
        "handler.LoginRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "handler.RegisterRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "full_name": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "handler.authResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/model.User"
                }
            }
        },
        "handler.createGameRequest": {
            "type": "object",
            "properties": {
                "level_id": {
                    "type": "integer"
                }
            }
        },
        "handler.levelAPIError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.FieldError"
                    }
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "handler.levelErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/handler.levelAPIError"
                }
            }
        },
        "handler.moveRequest": {
            "type": "object",
            "properties": {
                "column": {
                    "type": "integer"
                },
                "move": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "row": {
                    "type": "integer"
                }
            }
        },
        "handler.updateUserRoleRequest": {
            "type": "object",
            "properties": {
                "role": {
                    "$ref": "#/definitions/model.UserRole"
                }
            }
        },
        "model.APIError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "model.Difficulty": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "hard"
            ],
            "x-enum-varnames": [
                "DifficultyLow",
                "DifficultyMedium",
                "DifficultyHard"
            ]
        },
        "model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/model.APIError"
                }
            }
        },
        "model.FieldError": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "model.Game": {
            "type": "object",
            "properties": {
                "board": {
                    "description": "Board is the current derived position. It is not persisted; Init and Moves are the source of truth.",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "init": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "is_win": {
                    "type": "boolean",
                    "example": false
                },
                "level": {
                    "$ref": "#/definitions/model.Level"
                },
                "level_id": {
                    "type": "integer",
                    "example": 1
                },
                "moves": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    }
                },
                "user": {
                    "$ref": "#/definitions/model.User"
                },
                "user_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "model.Level": {
            "type": "object",
            "properties": {
                "columns": {
                    "type": "integer",
                    "maximum": 100,
                    "minimum": 2,
                    "example": 4
                },
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string",
                    "example": "A temple hidden in the jungle."
                },
                "difficulty": {
                    "enum": [
                        "low",
                        "medium",
                        "hard"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.Difficulty"
                        }
                    ],
                    "example": "medium"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "move_limit": {
                    "type": "integer",
                    "maximum": 10000,
                    "minimum": -1,
                    "example": 50
                },
                "objective": {
                    "description": "Objective describes what the player must accomplish to complete the level.",
                    "type": "string",
                    "example": "solve the puzzle"
                },
                "rows": {
                    "type": "integer",
                    "maximum": 100,
                    "minimum": 2,
                    "example": 4
                },
                "theme": {
                    "description": "Theme describes the level's setting, such as a temple, forest, or space station.",
                    "type": "string",
                    "example": "temple"
                },
                "time_limit": {
                    "type": "integer",
